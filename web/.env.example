# Copia este archivo a .env.local y rellena los valores.
# En local: `npx supabase status` (desde la raíz del repo) muestra la URL y la anon key.
# También admite "/supabase" para usar el proxy de Vite en el mismo origen (vista previa remota).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
